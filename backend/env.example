# MongoDB Connection String
# Replace with your actual MongoDB connection string

# For local MongoDB installation:
MONGO_URI=mongodb://localhost:27017/notemate

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/notemate?retryWrites=true&w=majority

# Server Configuration
PORT=5000

# JWT Secret (for authentication) - Change this to a secure random string
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production 